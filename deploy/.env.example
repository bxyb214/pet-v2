PET_JWT_SECRET=请生成一串64位随机字符串

# 开发/测试环境设为 1：右上角显示 DEV，AI 接口返回模拟结果，不产生外部调用
# 正式部署保持 0
PET_DEV_MODE=0

# 镜像版本。tools/deploy_nas.py 发布会自动传 PET_TAG；回滚用 rollback 子命令
# PET_TAG=20261125-194500-abc1234

# 数学课程视频在 NAS 宿主上的目录（只读挂载到 nginx 的 /media/math）
# 不设则用 compose 默认 /vol2/1000/media/felix/math
# PET_MATH_MEDIA=/vol2/1000/media/felix/math

# 数学视频媒体令牌有效期（小时）；令牌放视频 URL 的 ?mt=，无需登录态 Cookie。默认 6
# PET_MEDIA_TOKEN_HOURS=6

# 依赖镜像源（国内网络可覆盖）
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
